{
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "warn",
    "eqeqeq": "error",
    "prefer-const": "error"
  },
  "ignorePatterns": [
    "public/chunks/",
    "node_modules/",
    "tidarr/",
    "audiomuse/",
    "mediasage/"
  ]
}
